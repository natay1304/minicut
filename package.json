{
  "name": "minicut",
  "version": "0.3.1",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "mcp": "node src/mcp.js",
    "test": "MINICUT_DATA=$(mktemp -d) node --test test/",
    "lint": "eslint .",
    "format": "prettier --write src public test scripts *.js",
    "format:check": "prettier --check src public test scripts *.js",
    "mcp:install": "node scripts/install-mcp.mjs",
    "setup:speech": "node scripts/setup-speech.mjs"
  },
  "keywords": [
    "video-editor",
    "ffmpeg",
    "mcp",
    "reels"
  ],
  "author": "Anastasiya",
  "license": "MIT",
  "description": "Local web video editor for vertical reels: multi-track timeline, ffmpeg export, HTTP API and MCP server",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.2.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natay1304/minicut.git"
  }
}
